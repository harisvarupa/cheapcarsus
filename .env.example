NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Supabase values used by the browser for read paths.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values used by API routes. Never expose the service role key in the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=cars
ADMIN_ACCESS_KEY=change-this-long-random-admin-key

# Free API key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
